[Unit]
Description=VPS Monitor agent
After=network-online.target
Wants=network-online.target

[Service]
User=vpsmon-agent
Group=vpsmon-agent
EnvironmentFile=/etc/vpsmon-agent/env
ExecStart=/usr/local/bin/vpsmon-agent --server ${VPSMON_SERVER} --token-file /etc/vpsmon-agent/token
Restart=always
RestartSec=5
# Final report on stop (design 5.5) needs a moment
TimeoutStopSec=5

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
