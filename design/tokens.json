{
  "$comment": "设计令牌唯一来源（设计 41.2）。Web 由 web/scripts/gen-tokens.mjs 生成 web/src/styles/tokens.css；App 将生成 app/lib/theme/tokens.dart（TODO(C)）。修改后运行 npm run tokens。",
  "color": {
    "bg":          { "light": "#F6F7F9", "dark": "#0F1115", "use": "页面背景" },
    "surface":     { "light": "#FFFFFF", "dark": "#171A21", "use": "卡片、面板" },
    "surface-2":   { "light": "#F1F3F6", "dark": "#12151B", "use": "代码块、次级区域（41.2.1 之外的补充，用于命令块与说明框）" },
    "border":      { "light": "#E5E7EB", "dark": "#262A33", "use": "分隔线、卡片边框" },
    "text":        { "light": "#16181D", "dark": "#E6E8EC", "use": "主要文字" },
    "text-muted":  { "light": "#6B7280", "dark": "#8B93A1", "use": "次要文字、单位、说明" },
    "accent":      { "light": "#2563EB", "dark": "#3B82F6", "use": "主按钮、链接、选中态" },
    "on-accent":   { "light": "#FFFFFF", "dark": "#FFFFFF", "use": "主按钮、危险按钮上的文字" },
    "ok":          { "light": "#16A34A", "dark": "#22C55E", "use": "在线、正常" },
    "warn":        { "light": "#D97706", "dark": "#F59E0B", "use": "告警、未知、接近阈值" },
    "bad":         { "light": "#DC2626", "dark": "#EF4444", "use": "离线、超限、失败" },
    "muted-state": { "light": "#9CA3AF", "dark": "#6B7280", "use": "待安装、维护中、已静音" },
    "series-2": { "light": "#7C3AED", "dark": "#A78BFA", "use": "图表与分段环的第二类数据：CPU 系统时间、内存缓存" },
    "series-3": { "light": "#0891B2", "dark": "#22D3EE", "use": "图表与分段环的第三类数据：软中断等次要分类" },
    "track": { "light": "#E5E7EB", "dark": "#2A2F3A", "use": "环形图、每核条的底轨" },
    "qr-dark":  { "light": "#000000", "dark": "#000000", "use": "二维码模块：两种主题都是黑底白边，深色模式下也能被扫码识别" },
    "qr-light": { "light": "#FFFFFF", "dark": "#FFFFFF", "use": "二维码背景与静区" }
  },
  "font": {
    "family": "-apple-system, BlinkMacSystemFont, \"PingFang SC\", \"Segoe UI\", sans-serif",
    "mono": "ui-monospace, SFMono-Regular, Menlo, monospace",
    "xs":  { "size": 11, "line": 16, "use": "指标标签、角标" },
    "sm":  { "size": 12, "line": 18, "use": "说明文字、表格辅助信息" },
    "md":  { "size": 14, "line": 22, "use": "正文（默认）" },
    "lg":  { "size": 16, "line": 24, "use": "卡片标题" },
    "xl":  { "size": 20, "line": 28, "use": "页面标题" },
    "num": { "size": 28, "line": 32, "use": "关键数字（在线数、流量用量）" },
    "weight-regular": 400,
    "weight-strong": 600
  },
  "space": [4, 8, 12, 16, 20, 24, 32, 48],
  "radius": { "sm": 6, "md": 12, "full": 9999 },
  "layout": { "max-width": 1200, "card-min": 280 }
}
