<?xml version="1.0" encoding="utf-8"?>
<!-- 中 / 大尺寸：计数、更新时间、服务器列表（异常优先）与最近告警（设计 1.5.4） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vpsmon_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/vpsmon_widget_bg"
    android:padding="@dimen/vpsmon_space_4">

    <TextView
        android:id="@+id/vpsmon_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/vpsmon_widget_empty"
        android:textColor="@color/vpsmon_text_muted"
        android:textSize="@dimen/vpsmon_font_sm"
        android:visibility="visible" />

    <LinearLayout
        android:id="@+id/vpsmon_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="● "
                android:textColor="@color/vpsmon_ok" android:textSize="@dimen/vpsmon_font_xs" />
            <TextView android:id="@+id/vpsmon_online" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/vpsmon_text" android:textSize="@dimen/vpsmon_font_sm" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="   ● "
                android:textColor="@color/vpsmon_bad" android:textSize="@dimen/vpsmon_font_xs" />
            <TextView android:id="@+id/vpsmon_offline" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/vpsmon_text" android:textSize="@dimen/vpsmon_font_sm" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="   ● "
                android:textColor="@color/vpsmon_warn" android:textSize="@dimen/vpsmon_font_xs" />
            <TextView android:id="@+id/vpsmon_attention" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/vpsmon_text" android:textSize="@dimen/vpsmon_font_sm" android:textStyle="bold" />
            <TextView android:id="@+id/vpsmon_updated" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="end" android:maxLines="1" android:textSize="@dimen/vpsmon_font_xs" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingTop="@dimen/vpsmon_space_2">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:paddingStart="14dp" android:text="服务器" android:textColor="@color/vpsmon_text_muted" android:textSize="@dimen/vpsmon_font_xs" />
            <TextView android:layout_width="40dp" android:layout_height="wrap_content" android:gravity="end"
                android:text="CPU" android:textColor="@color/vpsmon_text_muted" android:textSize="@dimen/vpsmon_font_xs" />
            <TextView android:layout_width="40dp" android:layout_height="wrap_content" android:gravity="end"
                android:text="内存" android:textColor="@color/vpsmon_text_muted" android:textSize="@dimen/vpsmon_font_xs" />
            <TextView android:layout_width="76dp" android:layout_height="wrap_content" android:gravity="end"
                android:text="下载" android:textColor="@color/vpsmon_text_muted" android:textSize="@dimen/vpsmon_font_xs" />
        </LinearLayout>

        <LinearLayout android:id="@+id/vpsmon_rows" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- RemoteViews 不允许普通 View：用 FrameLayout 占位 -->
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

        <TextView android:id="@+id/vpsmon_alert" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end" android:textSize="@dimen/vpsmon_font_xs" android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
