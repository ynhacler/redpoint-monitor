<?xml version="1.0" encoding="utf-8"?>
<!-- 小尺寸：在线 / 离线 / 需要关注计数与状态句（设计 1.5.4） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vpsmon_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/vpsmon_widget_bg"
    android:padding="@dimen/vpsmon_space_4">

    <TextView
        android:id="@+id/vpsmon_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/vpsmon_widget_empty"
        android:textColor="@color/vpsmon_text_muted"
        android:textSize="@dimen/vpsmon_font_sm"
        android:visibility="visible" />

    <LinearLayout
        android:id="@+id/vpsmon_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●  "
                android:textColor="@color/vpsmon_ok" android:textSize="@dimen/vpsmon_font_sm" />
            <TextView android:id="@+id/vpsmon_online" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/vpsmon_text" android:textSize="@dimen/vpsmon_font_lg" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●  "
                android:textColor="@color/vpsmon_bad" android:textSize="@dimen/vpsmon_font_sm" />
            <TextView android:id="@+id/vpsmon_offline" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/vpsmon_text" android:textSize="@dimen/vpsmon_font_lg" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●  "
                android:textColor="@color/vpsmon_warn" android:textSize="@dimen/vpsmon_font_sm" />
            <TextView android:id="@+id/vpsmon_attention" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/vpsmon_text" android:textSize="@dimen/vpsmon_font_lg" android:textStyle="bold" />
        </LinearLayout>

        <!-- RemoteViews 不允许普通 View：用 FrameLayout 占位 -->
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

        <TextView android:id="@+id/vpsmon_summary" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end" android:textSize="@dimen/vpsmon_font_sm" android:textStyle="bold" />
        <TextView android:id="@+id/vpsmon_updated" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxLines="1" android:textSize="@dimen/vpsmon_font_xs" />
    </LinearLayout>
</FrameLayout>
