<?xml version="1.0" encoding="utf-8"?>
<!-- 【安全】正式构建只允许 HTTPS，只信任系统根证书（约束 6，设计 1.6.7）；不信任用户安装的证书 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
