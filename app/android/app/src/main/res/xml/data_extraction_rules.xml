<?xml version="1.0" encoding="utf-8"?>
<!-- 【安全】不做云备份与设备迁移：凭证在 Android Keystore 中，备份恢复后无法解密；服务器信息也不应离开本机（约束 7） -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
